# Anthropic
ANTHROPIC_API_KEY=

# Salesforce — JWT Bearer flow
# Generate cert pair: openssl req -x509 -newkey rsa:2048 -keyout server.key -out server.crt -days 365 -nodes
# Upload server.crt to the Connected App in Salesforce; paste the contents of server.key below.
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=
SF_USERNAME=
SF_PRIVATE_KEY=

# Salesforce -> Hook callout HMAC secret (set the same value in Custom Metadata in SF)
SF_CALLOUT_HMAC_SECRET=

# Slack
SLACK_BOT_TOKEN=xoxb-
SLACK_SIGNING_SECRET=
SLACK_REVOPS_CHANNEL_ID=

# Database (Neon Postgres)
DATABASE_URL=postgres://...

# Operational
HOOK_DRY_RUN=true
HOOK_GAP_THRESHOLD_USD=1

# When true, Hook auto-applies Account.ARR__c corrections WITHOUT a button click
# for accounts where every won opp is New Business / Pilot / Renewal AND there
# are no OFE disagreements AND no opps are ARR_Locked. Default off — flip to
# true after observing the human-in-the-loop tier in production.
HOOK_AUTO_CORRECT=false
