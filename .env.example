# Salesforce Connected App (Production)
SF_CLIENT_ID=your_connected_app_client_id
SF_CLIENT_SECRET=your_connected_app_client_secret
SF_CALLBACK_URL=http://localhost:3001/auth/callback
SF_LOGIN_URL=https://login.salesforce.com

# Salesforce Connected App (Sandbox) — optional, uses test.salesforce.com
SF_SANDBOX_CLIENT_ID=your_sandbox_connected_app_client_id
SF_SANDBOX_CLIENT_SECRET=your_sandbox_connected_app_client_secret

# Salesforce External Client App — Production (for Hosted MCP / mcp_api scope)
# Add http://localhost:3001/auth/mcp-callback as an allowed callback URL
SF_MCP_CLIENT_ID=your_external_client_app_consumer_key
SF_MCP_CLIENT_SECRET=your_external_client_app_consumer_secret

# Salesforce External Client App — Sandbox (optional)
SF_MCP_SANDBOX_CLIENT_ID=
SF_MCP_SANDBOX_CLIENT_SECRET=

# Anthropic (Claude API)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Session
SESSION_SECRET=your_random_session_secret

# Server
PORT=3001

# --- Slack Standup Bot (slack-bot/ workspace, deploys to Vercel) ---

# Slack app credentials
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_AUDIT_CHANNEL_ID=C0123456789

# Standup bot config
STANDUP_PUBLIC_URL=https://your-vercel-domain.vercel.app
STANDUP_OAUTH_STATE_SECRET=
STANDUP_INTERNAL_SECRET=
STANDUP_DRY_RUN=false
STANDUP_DEFAULT_TIMEZONE=America/Los_Angeles
STANDUP_DEFAULT_HOUR=16

# Google Calendar (per-rep OAuth; same Connected App callback pattern as Salesforce)
# Create a Web Application OAuth client at console.cloud.google.com → APIs & Services → Credentials.
# Authorized redirect URI: <STANDUP_PUBLIC_URL>/api/oauth/google/callback
# Enable the Google Calendar API on the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated email domains considered "internal" — we only fire calendar briefs when at
# least one attendee is OUTSIDE this list.
INTERNAL_EMAIL_DOMAINS=rogo.ai

# Gong (org-level integration credential)
GONG_ACCESS_KEY=
GONG_ACCESS_KEY_SECRET=
GONG_BASE_URL=https://api.gong.io
# Gong webhook auth — set ONE of these. JWT (preferred for prod) wins if both set.
# JWT path: Gong signs the webhook with the configured key; we verify HS256 (shared secret) or RS256 (PEM public key).
GONG_JWT_PUBLIC_KEY=
GONG_JWT_SECRET=
# URL-token fallback: Gong calls /api/gong/webhook?token=<value>. Simple but no signing.
GONG_WEBHOOK_TOKEN=

# Rogo Analytics Bot API (usage / customer data — Felix-facing contract)
ROGO_API_BASE_URL=https://rogo-analytics-bot-461481229379.us-central1.run.app
ROGO_API_KEY=
# Optional schema/column overrides — tune after running:
#   npm run probe -w slack-bot rogo-bootstrap
ROGO_DIRECTORY_SF_KEY=salesforce_account_id
ROGO_DIRECTORY_CUSTOMER_KEY=customer_id
ROGO_CUSTOMER_JOIN_COLUMN=customer_id
ROGO_CUSTOMER_TABLE=REPORT_ENTITIES.CUSTOMER

# Postgres (Vercel-injected when you link a Vercel Postgres store)
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# --- Red Team agent (separate Python service Merlin POSTs to) ---
# URL of the deployed Red Team Python service's /evaluate endpoint host.
RED_TEAM_AGENT_URL=
# 32-byte hex secret; same value must be configured on the Python service for
# HMAC-SHA256 verification of `X-RedTeam-Signature` + `X-RedTeam-Timestamp`.
RED_TEAM_AGENT_SECRET=
# If "true", Merlin assembles intel packs, calls the agent, and audits the
# result, but does NOT post the Slack DM. Use this for week-1 review.
RED_TEAM_SHADOW_MODE=true
# Comma-separated StageName values that are "advanced enough" to red-team.
# Empty (default) disables the feature entirely.
RED_TEAM_STAGE_ALLOWLIST=
# Comma-separated custom field API names to include in the intel pack. If
# empty, falls back to the built-in MEDDPICC defaults (see constants.ts).
RED_TEAM_OPP_FIELDS=
# Hour (UTC) for the daily sweep cron. Default 14 (matches vercel.json).
RED_TEAM_DAILY_SWEEP_HOUR_UTC=14
# Rollout-stage helper: when set, ALL Red Team DMs go to this Slack user id
# instead of the opp owner. Use during the "manager-only" rollout step.
RED_TEAM_REDIRECT_TO_SLACK_USER_ID=
