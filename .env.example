# Salesforce Connected App (Production)
SF_CLIENT_ID=your_connected_app_client_id
SF_CLIENT_SECRET=your_connected_app_client_secret
SF_CALLBACK_URL=http://localhost:3001/auth/callback
SF_LOGIN_URL=https://login.salesforce.com

# Salesforce Connected App (Sandbox) — optional, uses test.salesforce.com
SF_SANDBOX_CLIENT_ID=your_sandbox_connected_app_client_id
SF_SANDBOX_CLIENT_SECRET=your_sandbox_connected_app_client_secret

# Salesforce External Client App — Production (for Hosted MCP / mcp_api scope)
# Add http://localhost:3001/auth/mcp-callback as an allowed callback URL
SF_MCP_CLIENT_ID=your_external_client_app_consumer_key
SF_MCP_CLIENT_SECRET=your_external_client_app_consumer_secret

# Salesforce External Client App — Sandbox (optional)
SF_MCP_SANDBOX_CLIENT_ID=
SF_MCP_SANDBOX_CLIENT_SECRET=

# Anthropic (Claude API)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Session
SESSION_SECRET=your_random_session_secret

# Server
PORT=3001

# --- Slack Standup Bot (slack-bot/ workspace, deploys to Vercel) ---

# Slack app credentials
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_AUDIT_CHANNEL_ID=C0123456789

# Standup bot config
STANDUP_PUBLIC_URL=https://your-vercel-domain.vercel.app
STANDUP_OAUTH_STATE_SECRET=
STANDUP_INTERNAL_SECRET=
STANDUP_DRY_RUN=false
STANDUP_DEFAULT_TIMEZONE=America/Los_Angeles
STANDUP_DEFAULT_HOUR=16

# Gong (org-level integration credential)
GONG_ACCESS_KEY=
GONG_ACCESS_KEY_SECRET=
GONG_BASE_URL=https://api.gong.io

# Usage data (internal HTTP API — pending spec)
USAGE_API_URL=
USAGE_API_TOKEN=

# Postgres (Vercel-injected when you link a Vercel Postgres store)
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
