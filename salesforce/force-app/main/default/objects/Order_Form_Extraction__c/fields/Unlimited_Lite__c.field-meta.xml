<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Unlimited_Lite__c</fullName>
    <description>Whether the customer has access to Unlimited Lite queries/credits. "Yes"/"No" when explicitly stated. "Inferred (Enterprise)" when the doc doesn't say but Package_Tier__c=Enterprise (Enterprise typically includes Unlimited Lite - not guaranteed). "Not specified" otherwise.</description>
    <label>Unlimited Lite</label>
    <required>false</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value><fullName>Yes</fullName><default>false</default><label>Yes</label></value>
            <value><fullName>No</fullName><default>false</default><label>No</label></value>
            <value><fullName>Inferred (Enterprise)</fullName><default>false</default><label>Inferred (Enterprise)</label></value>
            <value><fullName>Not specified</fullName><default>false</default><label>Not specified</label></value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
