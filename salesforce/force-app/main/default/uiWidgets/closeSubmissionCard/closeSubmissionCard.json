{
  "type": "lightning__agentforceWidget",
  "contentBody": {
    "widgetBody": {
      "definition": "tile/widget",
      "children": [
        {
          "definition": "tile/column",
          "attributes": {
            "gap": "md"
          },
          "children": [
            {
              "definition": "tile/column",
              "attributes": {
                "gap": "md"
              },
              "children": [
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "md",
                    "align": "start",
                    "justify": "between"
                  },
                  "children": [
                    {
                      "definition": "tile/column",
                      "attributes": {
                        "gap": "xs",
                        "width": "stretch"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.headline}",
                            "variant": "h2"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.opportunityName}",
                            "variant": "caption",
                            "color": "muted"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/badge",
                      "attributes": {
                        "label": "{!$attrs.statusLabel}",
                        "variant": "{!$attrs.statusVariant}"
                      }
                    }
                  ]
                },
                {
                  "definition": "tile/text",
                  "attributes": {
                    "text": "{!$attrs.message}",
                    "variant": "body"
                  }
                }
              ]
            },
            {
              "definition": "tile/column",
              "attributes": {
                "gap": "sm"
              },
              "children": [
                {
                  "definition": "tile/separator",
                  "attributes": {
                    "orientation": "horizontal"
                  }
                },
                {
                  "definition": "tile/text",
                  "attributes": {
                    "text": "AI recommendation",
                    "variant": "h3"
                  }
                },
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "lg",
                    "align": "start"
                  },
                  "children": [
                    {
                      "definition": "tile/column",
                      "attributes": {
                        "gap": "xs",
                        "width": "stretch"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Recommended reason",
                            "variant": "caption",
                            "color": "muted"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.recommendedReason}",
                            "variant": "h4"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/column",
                      "attributes": {
                        "gap": "xs",
                        "width": "stretch"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Recommended competitor",
                            "variant": "caption",
                            "color": "muted"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.recommendedCompetitor}",
                            "variant": "h4"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/column",
                      "attributes": {
                        "gap": "xs",
                        "width": "stretch"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Confidence",
                            "variant": "caption",
                            "color": "muted"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.aiConfidence}",
                            "variant": "h4"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "definition": "tile/markdown",
                  "attributes": {
                    "source": "{!$attrs.recommendedNarrative}"
                  }
                },
                {
                  "definition": "tile/accordion",
                  "attributes": {},
                  "children": [
                    {
                      "definition": "tile/accordionitem",
                      "attributes": {
                        "title": "AI analysis details",
                        "isExpanded": false,
                        "iconName": "file-text",
                        "iconAlt": ""
                      },
                      "children": [
                        {
                          "definition": "tile/markdown",
                          "attributes": {
                            "source": "{!$attrs.aiSummary}"
                          }
                        }
                      ]
                    }
                  ]
                }
              ],
              "meta": {
                "if": "{!$attrs.hasRecommendation}"
              }
            },
            {
              "definition": "tile/callout",
              "attributes": {
                "title": "AI analysis unavailable",
                "variant": "warning"
              },
              "children": [
                {
                  "definition": "tile/text",
                  "attributes": {
                    "text": "{!$attrs.aiFailureReason}",
                    "variant": "body"
                  }
                }
              ],
              "meta": {
                "if": "{!$attrs.aiFailed}"
              }
            },
            {
              "definition": "tile/column",
              "attributes": {
                "gap": "sm"
              },
              "children": [
                {
                  "definition": "tile/text",
                  "attributes": {
                    "text": "Pick the loss reason",
                    "variant": "h3"
                  }
                },
                {
                  "definition": "tile/text",
                  "attributes": {
                    "text": "Choose a reason to preview with it, or ask for the full list.",
                    "variant": "caption",
                    "color": "muted"
                  }
                },
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "sm",
                    "align": "center",
                    "isWrapped": true
                  },
                  "children": [
                    {
                      "definition": "tile/button",
                      "attributes": {
                        "label": "{!$choice.label}",
                        "variant": "{!$choice.variant}",
                        "actions": {
                          "click": [
                            {
                              "definition": "action/sendMessage",
                              "attributes": {
                                "content": "{!$choice.prompt}"
                              }
                            }
                          ]
                        }
                      },
                      "meta": {
                        "forEach": "{!$attrs.reasonChoices}",
                        "forItem": "$choice"
                      }
                    }
                  ]
                }
              ],
              "meta": {
                "if": "{!$attrs.hasReasonChoices}"
              }
            },
            {
              "definition": "tile/column",
              "attributes": {
                "gap": "sm"
              },
              "children": [
                {
                  "definition": "tile/callout",
                  "attributes": {
                    "title": "Fix these before submitting",
                    "variant": "error",
                    "description": "Nothing has been saved."
                  }
                },
                {
                  "definition": "tile/table",
                  "attributes": {
                    "caption": "Problems to fix",
                    "size": "sm",
                    "appearance": "default",
                    "columns": [
                      {
                        "key": "label",
                        "header": "Field"
                      },
                      {
                        "key": "value",
                        "header": "Issue"
                      }
                    ],
                    "rows": "{!$attrs.problems}"
                  }
                }
              ],
              "meta": {
                "if": "{!$attrs.hasProblems}"
              }
            },
            {
              "definition": "tile/separator",
              "attributes": {
                "orientation": "horizontal"
              }
            },
            {
              "definition": "tile/column",
              "attributes": {
                "gap": "sm"
              },
              "children": [
                {
                  "definition": "tile/text",
                  "attributes": {
                    "text": "Values",
                    "variant": "h3"
                  }
                },
                {
                  "definition": "tile/table",
                  "attributes": {
                    "caption": "Values to be written",
                    "size": "sm",
                    "appearance": "default",
                    "columns": [
                      {
                        "key": "label",
                        "header": "Field"
                      },
                      {
                        "key": "value",
                        "header": "Value"
                      }
                    ],
                    "rows": "{!$attrs.rows}"
                  }
                }
              ]
            },
            {
              "definition": "tile/column",
              "attributes": {
                "gap": "sm"
              },
              "children": [
                {
                  "definition": "tile/callout",
                  "attributes": {
                    "title": "Nothing saved yet",
                    "variant": "info",
                    "description": "Confirm to submit these values, or tell the agent what to change."
                  },
                  "meta": {
                    "if": "{!$attrs.isPreview}"
                  }
                },
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "sm",
                    "align": "center"
                  },
                  "children": [
                    {
                      "definition": "tile/button",
                      "attributes": {
                        "label": "Confirm and submit",
                        "variant": "primary",
                        "actions": {
                          "click": [
                            {
                              "definition": "action/sendMessage",
                              "attributes": {
                                "content": "{!$attrs.confirmPrompt}"
                              }
                            }
                          ]
                        }
                      }
                    },
                    {
                      "definition": "tile/button",
                      "attributes": {
                        "label": "Change something",
                        "variant": "secondary",
                        "actions": {
                          "click": [
                            {
                              "definition": "action/sendMessage",
                              "attributes": {
                                "content": "{!$attrs.changePrompt}"
                              }
                            }
                          ]
                        }
                      }
                    }
                  ],
                  "meta": {
                    "if": "{!$attrs.isPreview}"
                  }
                },
                {
                  "definition": "tile/callout",
                  "attributes": {
                    "title": "Submitted",
                    "variant": "success"
                  },
                  "children": [
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$attrs.message}",
                        "variant": "body"
                      }
                    }
                  ],
                  "meta": {
                    "if": "{!$attrs.isSubmitted}"
                  }
                },
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "sm",
                    "align": "center"
                  },
                  "children": [
                    {
                      "definition": "tile/button",
                      "attributes": {
                        "label": "Open in Salesforce",
                        "variant": "secondary",
                        "actions": {
                          "click": [
                            {
                              "definition": "action/openLink",
                              "attributes": {
                                "url": "{!$attrs.opportunityUrl}",
                                "target": "_blank"
                              }
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
