{
  "type": "lightning__agentforceWidget",
  "contentBody": {
    "widgetBody": {
      "definition": "tile/widget",
      "children": [
        {
          "definition": "tile/column",
          "attributes": {
            "gap": "md"
          },
          "children": [
            {
              "definition": "tile/column",
              "attributes": {
                "gap": "md"
              },
              "children": [
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "md",
                    "align": "start",
                    "justify": "between"
                  },
                  "children": [
                    {
                      "definition": "tile/column",
                      "attributes": {
                        "gap": "xs",
                        "width": "stretch"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.opportunityName}",
                            "variant": "h2"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.accountName}",
                            "variant": "caption",
                            "color": "muted"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/badge",
                      "attributes": {
                        "label": "{!$attrs.statusLabel}",
                        "variant": "{!$attrs.statusVariant}"
                      }
                    }
                  ]
                },
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "lg",
                    "align": "start"
                  },
                  "children": [
                    {
                      "definition": "tile/column",
                      "attributes": {
                        "gap": "xs",
                        "width": "stretch"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Stage",
                            "variant": "caption",
                            "color": "muted"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.stageName}",
                            "variant": "h4"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/column",
                      "attributes": {
                        "gap": "xs",
                        "width": "stretch"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Amount",
                            "variant": "caption",
                            "color": "muted"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.amount}",
                            "variant": "h4"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/column",
                      "attributes": {
                        "gap": "xs",
                        "width": "stretch"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Close Date",
                            "variant": "caption",
                            "color": "muted"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.closeDate}",
                            "variant": "h4"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/column",
                      "attributes": {
                        "gap": "xs",
                        "width": "stretch"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Type",
                            "variant": "caption",
                            "color": "muted"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.opportunityType}",
                            "variant": "h4"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "definition": "tile/text",
                  "attributes": {
                    "text": "{!$attrs.statusMessage}",
                    "variant": "body"
                  }
                }
              ]
            },
            {
              "definition": "tile/column",
              "attributes": {
                "gap": "sm"
              },
              "children": [
                {
                  "definition": "tile/callout",
                  "attributes": {
                    "title": "Signed order form required",
                    "variant": "error",
                    "description": "{!$attrs.signedDocumentText}"
                  },
                  "meta": {
                    "if": "{!$attrs.missingSignedDocument}"
                  }
                },
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "sm",
                    "align": "center"
                  },
                  "children": [
                    {
                      "definition": "tile/icon",
                      "attributes": {
                        "name": "check-circle",
                        "size": "sm",
                        "color": "success",
                        "alt": ""
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "Signed order form",
                        "variant": "body",
                        "weight": "semibold"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$attrs.signedDocumentText}",
                        "variant": "body",
                        "color": "muted"
                      }
                    }
                  ],
                  "meta": {
                    "if": "{!$attrs.hasSignedDocument}"
                  }
                }
              ]
            },
            {
              "definition": "tile/separator",
              "attributes": {
                "orientation": "horizontal"
              }
            },
            {
              "definition": "tile/column",
              "attributes": {
                "gap": "sm"
              },
              "children": [
                {
                  "definition": "tile/text",
                  "attributes": {
                    "text": "Closed Won checklist",
                    "variant": "h3"
                  }
                },
                {
                  "definition": "tile/table",
                  "attributes": {
                    "caption": "Closed Won field checklist",
                    "size": "sm",
                    "appearance": "default",
                    "columns": [
                      {
                        "key": "label",
                        "header": "Field"
                      },
                      {
                        "key": "value",
                        "header": "Current value"
                      }
                    ],
                    "rows": "{!$attrs.checklist}"
                  }
                },
                {
                  "definition": "tile/callout",
                  "attributes": {
                    "title": "Fields still needed",
                    "variant": "warning"
                  },
                  "children": [
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$attrs.missingFieldsText}",
                        "variant": "body"
                      }
                    }
                  ],
                  "meta": {
                    "if": "{!$attrs.hasMissingFields}"
                  }
                }
              ]
            },
            {
              "definition": "tile/column",
              "attributes": {
                "gap": "sm"
              },
              "children": [
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "sm",
                    "align": "center"
                  },
                  "children": [
                    {
                      "definition": "tile/button",
                      "attributes": {
                        "label": "Close as Won",
                        "variant": "primary",
                        "actions": {
                          "click": [
                            {
                              "definition": "action/sendMessage",
                              "attributes": {
                                "content": "{!$attrs.closeWonPrompt}"
                              }
                            }
                          ]
                        }
                      }
                    },
                    {
                      "definition": "tile/button",
                      "attributes": {
                        "label": "Close as Lost",
                        "variant": "secondary",
                        "actions": {
                          "click": [
                            {
                              "definition": "action/sendMessage",
                              "attributes": {
                                "content": "{!$attrs.closeLostPrompt}"
                              }
                            }
                          ]
                        }
                      }
                    },
                    {
                      "definition": "tile/button",
                      "attributes": {
                        "label": "Open in Salesforce",
                        "variant": "secondary",
                        "actions": {
                          "click": [
                            {
                              "definition": "action/openLink",
                              "attributes": {
                                "url": "{!$attrs.opportunityUrl}",
                                "target": "_blank"
                              }
                            }
                          ]
                        }
                      }
                    }
                  ],
                  "meta": {
                    "if": "{!$attrs.canClose}"
                  }
                },
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "sm",
                    "align": "center"
                  },
                  "children": [
                    {
                      "definition": "tile/button",
                      "attributes": {
                        "label": "Open in Salesforce",
                        "variant": "secondary",
                        "actions": {
                          "click": [
                            {
                              "definition": "action/openLink",
                              "attributes": {
                                "url": "{!$attrs.opportunityUrl}",
                                "target": "_blank"
                              }
                            }
                          ]
                        }
                      }
                    }
                  ],
                  "meta": {
                    "if": "{!$attrs.isClosed}"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
