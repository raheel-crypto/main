# Shared HMAC secret with Merlin. Generate with: openssl rand -hex 32
# Must match RED_TEAM_AGENT_SECRET on the slack-bot side.
RED_TEAM_AGENT_SECRET=

# Anthropic
ANTHROPIC_API_KEY=
RED_TEAM_MODEL=claude-sonnet-4-20250514
RED_TEAM_MAX_TOKENS=2048

# How long an opp is cooled-down after an eval (minutes).
RED_TEAM_COOLDOWN_MINUTES=60

# Where to write state/cooldowns.json. Set to a writable mount when
# deploying. On Vercel functions, swap cooldowns.py for a Postgres-backed
# impl — the filesystem is read-only.
RED_TEAM_STATE_DIR=./state

# uvicorn port for local dev. Vercel ignores this.
PORT=3003
