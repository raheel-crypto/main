# Shared HMAC secret with Merlin. Generate with: openssl rand -hex 32
# Must match RED_TEAM_AGENT_SECRET on the slack-bot side.
RED_TEAM_AGENT_SECRET=

# Anthropic — Managed Agent API
# The Red Team service no longer calls messages.create() directly. Each eval
# spins up a session against the pre-built "RedHat Merlin" managed agent
# which has the red-team base prompt and `submit_argument` custom tool
# pre-configured.
ANTHROPIC_API_KEY=
RED_TEAM_AGENT_ID=                       # agent_xxx
RED_TEAM_ENVIRONMENT_ID=                 # env_xxx
RED_TEAM_VAULT_IDS=                      # vlt_xxx,vlt_yyy (comma-separated)

# How long an opp is cooled-down after an eval (minutes).
RED_TEAM_COOLDOWN_MINUTES=60

# Postgres — shared with the slack-bot project on Vercel. Cooldowns are
# stored in the `red_team_cooldowns` table; the bot's migration owns the
# schema (see slack-bot/src/db/schema.sql).
POSTGRES_URL=
# Optional: cap the per-instance connection pool. Vercel Python functions
# get little concurrency so the default of 4 is generous.
RED_TEAM_PG_MAX_CONNS=4

# uvicorn port for local dev. Vercel ignores this.
PORT=3003
